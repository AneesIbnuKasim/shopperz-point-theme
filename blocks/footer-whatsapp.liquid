{% assign block_settings = block.settings %}

{% if block_settings.link != blank %}
  <div class="footer-whatsapp" {{ block.shopify_attributes }}>
    {% if block_settings.heading != blank %}
      <p class="footer-whatsapp__heading">{{ block_settings.heading | escape }}</p>
    {% endif %}
    {% if block_settings.text != blank %}
      <p class="footer-whatsapp__text">{{ block_settings.text | escape }}</p>
    {% endif %}
    <a
      class="footer-whatsapp__link button button-secondary"
      href="{{ block_settings.link }}"
      {% if block_settings.open_in_new_tab %}
        target="_blank" rel="noopener noreferrer"
      {% endif %}
    >
      {{ block_settings.label | escape }}
    </a>
  </div>
{% endif %}

{% stylesheet %}
  .footer-whatsapp {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-xs);
  }

  .footer-whatsapp__heading {
    margin: 0;
    color: var(--color-foreground);
    font-family: var(--font-subheading--family);
    font-size: var(--font-size--xs);
    font-weight: var(--font-subheading--weight);
    letter-spacing: var(--letter-spacing-sm);
  }

  .footer-whatsapp__text {
    max-width: 26rem;
    margin: 0 0 var(--padding-xs);
    color: var(--color-foreground-subdued);
  }

  .footer-whatsapp__link {
    border-radius: var(--style-border-radius-sm);
    padding-block: var(--padding-sm);
    padding-inline: var(--padding-lg);
    font-family: var(--font-subheading--family);
    font-size: var(--font-size--xs);
    font-weight: var(--font-subheading--weight);
    letter-spacing: var(--letter-spacing-sm);
  }

  @media screen and (max-width: 749px) {
    .footer-whatsapp {
      width: 100%;
    }

    .footer-whatsapp__link {
      width: 100%;
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "WhatsApp channel",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "STAY CONNECTED"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Get updates, new arrivals and gifting inspiration."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "default": "JOIN OUR WHATSAPP CHANNEL"
    },
    {
      "type": "url",
      "id": "link",
      "label": "WhatsApp channel URL"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in new tab",
      "default": true
    }
  ]
}
{% endschema %}
